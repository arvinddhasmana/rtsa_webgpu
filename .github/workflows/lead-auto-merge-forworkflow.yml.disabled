# CLASSIFICATION: UNCLASSIFIED
name: Lead Gatekeeper (Review & Auto-Merge)

on:
  pull_request:
    # Include 'labeled' so PRs that receive the label after being opened are caught.
    types: [opened, synchronize, reopened, ready_for_review, labeled]

jobs:
  test-and-merge:
    runs-on: ubuntu-latest
    # Gate solely on the label — the actor name of the Copilot bot varies across
    # environments and is not a reliable filter.
    if: contains(github.event.pull_request.labels.*.name, 'ai-orchestrator')
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Run Automated Tests
        run: |
          echo "Replace this line with your actual test command (e.g., npm test, pytest, etc.)"
          echo "If this step fails, the workflow stops, and the PR is NOT merged."

      - name: Approve Pull Request
        # A PAT must be used here. The github-actions[bot] token cannot approve
        # or merge Copilot-authored PRs due to GitHub's self-review restrictions.
        env:
          GH_TOKEN: ${{ secrets.PAT_TOKEN }}
        run: gh pr review --approve "${{ github.event.pull_request.html_url }}"

      - name: Merge Pull Request
        env:
          GH_TOKEN: ${{ secrets.PAT_TOKEN }}
        # Squash merge without --auto so it works regardless of branch-protection config.
        # --yes suppresses any interactive confirmation prompt in non-TTY CI environments.
        run: gh pr merge --squash --yes "${{ github.event.pull_request.html_url }}"
