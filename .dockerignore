# CLASSIFICATION: UNCLASSIFIED
# .dockerignore — exclude large/conflicting paths from all Docker build contexts

# Node.js build artefacts
web-cop-gpu/node_modules/
web-cop-gpu/dist/
web-cop-gpu/playwright-report/
web-cop-gpu/test-results/
web-cop-gpu/wasm-decoder/target/

# Go build cache
**/vendor/
**/*.test

# Git
.git/
.github/

# Dev environment
*.env.local
*.env.development.local

# IDE
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Test infrastructure (not needed for service images)
tests/
