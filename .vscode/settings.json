{
    // CLASSIFICATION: UNCLASSIFIED
    // ─────────────────────────────────────────────────────────────────────────────
    // RTSA VS Code Workspace Settings
    // Project: Real-Time Situational Awareness & Risk Assessment
    // ─────────────────────────────────────────────────────────────────────────────
    // ── GitHub Copilot — Agent & Prompt File Configuration ──────────────────────
    // Enable Copilot Chat experimental features including custom agents
    "github.copilot.chat.experimental.agentDesktop": true,
    // Enable reusable prompt files from .github/prompts/
    "github.copilot.chat.experimental.prompt-files": true,
    // Enable Copilot "agent mode" for multi-step agentic task execution
    "github.copilot.chat.agent.enabled": true,
    // Allow agents to run terminal commands (required for build/test validation)
    "chat.agent.enableTerminalTool": true,
    // Allow agents to automatically run and iterate on code
    "github.copilot.chat.autoRunTools": true,
    // ── GitHub Copilot — Coding Behaviour ───────────────────────────────────────
    // Always include repository-level instructions from .github/copilot-instructions.md
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    // Enable inline suggestions
    "github.copilot.enable": {
        "*": true,
        "markdown": true,
        "plaintext": false,
        "yaml": true,
        "go": true,
        "proto3": true,
        "typescriptreact": true,
        "typescript": true,
        "sql": true
    },
    // Copilot inline suggestion commit character
    "editor.inlineSuggest.enabled": true,
    // ── GitHub Copilot — PR & Review Integration ─────────────────────────────────
    // Enable Copilot for PR descriptions and review summaries
    "github.copilot.chat.pullRequestDescriptionGeneration.enabled": true,
    // ── Go Language Settings ─────────────────────────────────────────────────────
    "go.useLanguageServer": true,
    "go.lintTool": "golangci-lint",
    "go.lintOnSave": "workspace",
    "go.vetOnSave": "workspace",
    "go.buildOnSave": "workspace",
    "go.testFlags": [
        "-race",
        "-v",
        "-count=1"
    ],
    "go.coverageDecorator": {
        "type": "highlight"
    },
    "go.coverOnSave": false,
    "go.formatTool": "goimports",
    // ── Editor — General ─────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll": "explicit"
    },
    "editor.rulers": [
        120
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // ── Files — Exclusions ────────────────────────────────────────────────────────
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/bin": true,
        "**/__pycache__": true
    },
    // ── Search — Exclusions ───────────────────────────────────────────────────────
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/bin": true,
        "**/vendor": true
    },
    // ── Terminal ──────────────────────────────────────────────────────────────────
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.env.windows": {
        "GOPROXY": "direct",
        "GONOSUMCHECK": "*"
    },
    // ── Extensions — Recommended ─────────────────────────────────────────────────
    // See .vscode/extensions.json for the recommended extensions list
    // ── Protobuf ─────────────────────────────────────────────────────────────────
    "[proto3]": {
        "editor.defaultFormatter": "zxh404.vscode-proto3",
        "editor.formatOnSave": true
    },
    // ── TypeScript / React ────────────────────────────────────────────────────────
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true
}
