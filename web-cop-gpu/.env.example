# CLASSIFICATION: UNCLASSIFIED
# web-cop-gpu/.env.example — Vite environment variables for the WebGPU COP frontend
# Copy this file to .env.local and update values for your local environment.
# DO NOT commit .env or .env.local — both are in .gitignore.

# ─────────────────────────────────────────────────────────────
# gRPC-Web / REST API gateway (Envoy cold path)
# Used by: src/services/grpc-client.ts, src/services/auth.ts
# ─────────────────────────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────
# WebTransport hot-path server
# When unset, the Data Worker falls back to mock mode.
# MUST be an https:// URL (QUIC requires TLS).
# Used by: src/App.tsx → data-worker.ts
# ─────────────────────────────────────────────────────────────
VITE_WEBTRANSPORT_URL=https://localhost:4433/wt
