{
  "name": "@rtsa/web-cop-gpu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "prebuild": "mkdir -p public/wasm && cp -r wasm-decoder/pkg/. public/wasm/ || echo 'wasm-decoder/pkg/ not found — run wasm-pack build first'",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit --project tsconfig.demo.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "leaflet": "^1.9.4",
    "pngjs": "^7.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^1.6.0"
  }
}
